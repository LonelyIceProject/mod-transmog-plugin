{
  "group": { "en": "Transmogrification", "ru": "Трансмогрификация" },
  "hint": {
    "en": "Changes take effect after a restart, or at once with .reload config followed by .transmog reload",
    "ru": "Изменения вступают в силу после перезапуска или сразу после .reload config и затем .transmog reload"
  },
  "fields": [
    { "key": "Transmogrification.Enable", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Transmogrification enabled", "ru": "Трансмогрификация включена" },
      "hint": { "en": "Off: transmogrified looks are hidden; the saved data stays", "ru": "Выкл.: изменённый облик не виден; сохранённые данные остаются" } },
    { "key": "Transmogrification.UseCollectionSystem", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Appearance collection", "ru": "Коллекция обликов" },
      "hint": { "en": "Any item you have equipped or got from a quest can be used; off: only items in your bags", "ru": "Можно использовать любой надетый предмет или награду за задание; выкл.: только предметы в сумках" } },
    { "key": "Transmogrification.UseVendorInterface", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Choose looks in a vendor window", "ru": "Выбор облика в окне торговца" },
      "hint": { "en": "With ctrl-click previews; off: a gossip menu", "ru": "С предпросмотром по Ctrl+щелчку; выкл.: меню диалога" } },
    { "key": "Transmogrification.EnablePortable", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Portable transmogrifier", "ru": "Переносной трансмогрификатор" } },
    { "key": "Transmogrification.AllowHiddenTransmog", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Hiding equipment", "ru": "Скрытие экипировки" } },
    { "key": "Transmogrification.HiddenTransmogIsFree", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Hiding is free", "ru": "Скрытие бесплатно" } },
    { "key": "Transmogrification.RetroActiveAppearances", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Collect appearances of completed quests", "ru": "Собирать облики из выполненных заданий" },
      "hint": { "en": "Checked once per character", "ru": "Проверяется один раз для каждого персонажа" } },
    { "key": "Transmogrification.ShowSetDisclaimer", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Set bonus notice", "ru": "Напоминание о бонусах комплекта" },
      "hint": { "en": "Tells that set bonuses stay active although the tooltip does not show them", "ru": "Сообщает, что бонусы комплекта действуют, хотя подсказка их не показывает" } },
    { "key": "Transmogrification.ScaledCostModifier", "type": "float", "min": 0, "default": 1.0, "apply": "restart",
      "label": { "en": "Price multiplier", "ru": "Множитель цены" },
      "hint": { "en": "0: no default price", "ru": "0: без обычной цены" } },
    { "key": "Transmogrification.CopperCost", "type": "int", "min": 0, "default": 0, "apply": "restart",
      "label": { "en": "Extra price, copper", "ru": "Доплата, в меди" } },
    { "key": "Transmogrification.RequireToken", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Costs tokens", "ru": "Стоит жетонов" } },
    { "key": "Transmogrification.TokenEntry", "type": "int", "min": 0, "default": 49426, "apply": "restart",
      "label": { "en": "Token item", "ru": "Предмет-жетон" },
      "hint": { "en": "item_template entry; 49426: Emblem of Frost", "ru": "Номер из item_template; 49426: эмблема льда" } },
    { "key": "Transmogrification.TokenAmount", "type": "int", "min": 0, "default": 1, "apply": "restart",
      "label": { "en": "Tokens per item", "ru": "Жетонов за предмет" } },
    { "key": "Transmogrification.AllowPoor", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Poor items", "ru": "Предметы низкого качества" } },
    { "key": "Transmogrification.AllowCommon", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Common items", "ru": "Обычные предметы" } },
    { "key": "Transmogrification.AllowUncommon", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Uncommon items", "ru": "Необычные предметы" } },
    { "key": "Transmogrification.AllowRare", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Rare items", "ru": "Редкие предметы" } },
    { "key": "Transmogrification.AllowEpic", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Epic items", "ru": "Эпические предметы" } },
    { "key": "Transmogrification.AllowLegendary", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Legendary items", "ru": "Легендарные предметы" } },
    { "key": "Transmogrification.AllowArtifact", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Artifact items", "ru": "Артефакты" } },
    { "key": "Transmogrification.AllowHeirloom", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Heirloom items", "ru": "Фамильные предметы" } },
    { "key": "Transmogrification.AllowTradeable", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Items still tradeable", "ru": "Предметы, которые ещё можно передать" },
      "hint": { "en": "During the 2 hour window to trade loot within the raid", "ru": "В течение 2 часов, пока добычу можно передать участникам рейда" } },
    { "key": "Transmogrification.AllowMixedArmorTypes", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Mix armor types", "ru": "Смешивать типы брони" },
      "hint": { "en": "Cloth on plate, for example", "ru": "Например, ткань на латы" } },
    { "key": "Transmogrification.AllowLowerTiers", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Lower armor types you can wear", "ru": "Более лёгкая броня, которую можно носить" },
      "hint": { "en": "A warrior may use cloth looks on plate", "ru": "Воин может надеть облик ткани на латы" } },
    { "key": "Transmogrification.AllowMixedOffhandArmorTypes", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Mix shields and off-hand items", "ru": "Смешивать щиты и предметы для левой руки" } },
    { "key": "Transmogrification.AllowMixedWeaponTypes", "type": "choice", "default": 0, "apply": "restart",
      "label": { "en": "Weapon types", "ru": "Типы оружия" },
      "options": [
        { "value": "0", "label": { "en": "Strict: same weapon type", "ru": "Строго: тот же тип оружия" } },
        { "value": "1", "label": { "en": "Modern: e.g. swords to axes", "ru": "Как в поздних версиях: например, мечи в топоры" } },
        { "value": "2", "label": { "en": "Full: any weapon to any weapon", "ru": "Полностью: любое оружие в любое" } }
      ] },
    { "key": "Transmogrification.AllowMixedWeaponHandedness", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Mix main-hand and off-hand weapons", "ru": "Смешивать оружие правой и левой руки" } },
    { "key": "Transmogrification.AllowFishingPoles", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Fishing poles", "ru": "Удочки" } },
    { "key": "Transmogrification.IgnoreReqLevel", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Ignore the source item's required level", "ru": "Не учитывать требуемый уровень предмета-образца" } },
    { "key": "Transmogrification.IgnoreReqClass", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Ignore the source item's required class", "ru": "Не учитывать требуемый класс предмета-образца" } },
    { "key": "Transmogrification.IgnoreReqRace", "type": "bool", "default": 0, "apply": "restart",
      "label": { "en": "Ignore the source item's required race", "ru": "Не учитывать требуемую расу предмета-образца" } },
    { "key": "Transmogrification.EnableSets", "type": "bool", "default": 1, "apply": "restart",
      "label": { "en": "Saved sets", "ru": "Сохранённые комплекты" } },
    { "key": "Transmogrification.MaxSets", "type": "int", "min": 0, "max": 25, "default": 10, "apply": "restart",
      "label": { "en": "Sets per character", "ru": "Комплектов на персонажа" } },
    { "key": "Transmogrification.SetCostModifier", "type": "float", "min": 0, "default": 3.0, "apply": "restart",
      "label": { "en": "Set price multiplier", "ru": "Множитель цены комплекта" },
      "hint": { "en": "0: no default price", "ru": "0: без обычной цены" } }
  ]
}
